<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginEnd="15dp">
    <ImageView android:id="@+id/img" android:layout_width="62dp" android:layout_height="62dp"
        android:background="@drawable/image_shape" android:padding="5dp" android:scaleType="centerInside"/>
    <TextView android:id="@+id/txt" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:textSize="12sp" android:textColor="#000000"
        android:layout_gravity="center"/>
</LinearLayout>